# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Free APIs (no keys required for most)
# Google Maps / Places - use free tier or OSM/Nominatim
GOOGLE_MAPS_API_KEY=""  # Optional: for enhanced features
NOMINATIM_USER_AGENT="LeadGenPlatform/1.0"

# Currency Exchange (free)
EXCHANGE_RATE_API="https://open.er-api.com/v6/latest"

# Weather (free)
OPEN_METEO_API="https://api.open-meteo.com/v1/forecast"

# Images (free)
PEXELS_API_KEY=""  # Optional: for higher rate limits
UNSPLASH_ACCESS_KEY=""  # Optional

# Social Media (via Composio or direct)
COMPOSIO_API_KEY=""
INSTAGRAM_ACCOUNTS=""  # JSON array of account IDs

# WhatsApp (Meta Cloud API)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_WEBHOOK_URL=""

# Email (optional - for outreach)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""

# Analytics
VERCEL_ANALYTICS_ID=""

# Feature Flags
ENABLE_AI_CONTENT="true"
ENABLE_PRICE_MONITORING="true"
ENABLE_GMB_SYNC="true"