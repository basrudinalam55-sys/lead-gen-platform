generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums converted to String fields for SQLite compatibility
// Use String with validation in application code

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("USER")
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  services      Service[]
  tasks         Task[]    @relation("AssignedTasks")
  createdTasks  Task[]    @relation("CreatedTasks")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id              String        @id @default(cuid())
  name            String
  type            String        // GOOGLE_MAPS_LEAD_GEN, COMPETITOR_PRICE_MONITORING, SOCIAL_MEDIA_CONTENT_PIPELINE, WHATSAPP_AUTOMATION, LOCAL_SEO_GMB
  description     String        // @db.Text removed
  priceSetup      Int           @default(0)
  priceMonthly    Int           @default(0)
  currency        String        @default("NPR")
  status          String        @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, PENDING
  features        String        // JSON stringified array
  targetIndustries String       // JSON stringified array
  apiSources      String        // JSON stringified array
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads           Lead[]
  tasks           Task[]
  competitorPrices CompetitorPrice[]
  socialContent   SocialContent[]
  gmbProfiles     GMBProfile[]
  whatsappTemplates WhatsAppTemplate[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Lead {
  id              String      @id @default(cuid())
  name            String
  businessName    String?
  email           String?
  phone           String?
  whatsapp        String?
  instagram       String?
  website         String?
  address         String?
  city            String?
  country         String      @default("Nepal")
  latitude        Float?
  longitude       Float?
  industry        String?
  businessType    String?
  source          String      @default("MANUAL")
  status          String      @default("NEW") // NEW, CONTACTED, QUALIFIED, DEMO_SCHEDULED, DEMO_COMPLETED, PROPOSAL_SENT, NEGOTIATING, CLOSED_WON, CLOSED_LOST
  score           Int         @default(0)
  tags            String      // JSON stringified array
  notes           String?
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  outreachLogs    OutreachLog[]
  tasks           Task[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
}

model OutreachLog {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel     String           // EMAIL, WHATSAPP, INSTAGRAM_DM, PHONE, IN_PERSON, LINKEDIN
  direction   String           // INBOUND / OUTBOUND
  subject     String?
  content     String
  metadata    String?          // JSON
  sentAt      DateTime         @default(now())
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        String      // LEAD_RESEARCH, OUTREACH, DEMO, FOLLOW_UP, PROPOSAL, ONBOARDING, CONTENT_CREATION, REPORTING
  status      String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    Int         @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User        @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  metadata    String?     // JSON
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CompetitorPrice {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  competitorName String
  productName   String
  productUrl    String?
  price         Float
  currency      String   @default("NPR")
  availability  String?
  metadata      String?  // JSON
  scrapedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
}

model SocialContent {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  platform      String   // INSTAGRAM, FACEBOOK, LINKEDIN, TWITTER, TIKTOK
  contentType   String   // POST, STORY, REEL, CAROUSEL
  caption       String?
  mediaUrls     String   // JSON stringified array
  hashtags      String   // JSON stringified array
  scheduledAt   DateTime
  publishedAt   DateTime?
  status        String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  engagement    String?  // JSON
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GMBProfile {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  placeId         String   @unique
  businessName    String
  address         String
  phone           String?
  website         String?
  category        String
  rating          Float?
  reviewCount     Int?
  latitude        Float?
  longitude       Float?
  hours           String?  // JSON
  photos          String   // JSON stringified array
  verified        Boolean  @default(false)
  optimizationScore Int    @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  category    String   // UTILITY, MARKETING, AUTHENTICATION
  language    String   @default("en_US")
  header      String?
  body        String
  footer      String?
  buttons     String?  // JSON
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  metaTemplateId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  eventType String
  eventData String   // JSON
  timestamp DateTime @default(now())
}

model ApiUsageLog {
  id          String   @id @default(cuid())
  serviceId   String?
  apiName     String
  endpoint    String
  method      String
  statusCode  Int?
  responseTime Int?    // ms
  requestData String?  // JSON
  responseData String? // JSON
  error       String?
  createdAt   DateTime @default(now())
}